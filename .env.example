# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_DB=layermed_db
POSTGRES_PASSWORD=postgres
# if you use Docker should use postgresql-app for POSTGRES_HOST
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PostgreSQL for tests
TEST_POSTGRES_USER=testpostgres
TEST_POSTGRES_DB=test_layermed_db
TEST_POSTGRES_PASSWORD=testpostgres
TEST_POSTGRES_PORT=5434

# Redis
# if you use Docker should use redis-app for REDIS_HOST
REDIS_HOST=localhost 
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Settings
KEY=change_this_to_a_secure_random_secret_key # execute: openssl rand -hex 32 and paste here
ALGORITHM=HS256
DUMMY_PASSWORD_HASH='$2b$12$liS94xlilOmkVG.NyGtEMOYKfvOgfxis0jem1MOq.fOW4IobaQFR.'

# S3 SETTINGS
S3_ENDPOINT=https://storage.yandexcloud.net
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET_NAME=general-media

DEBUG=True
PYTHONPATH=src